{$OPENMAIL_DOMAIN:mcp.openmail.tools} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy openmail:8080 {
		# MCP streamable HTTP uses SSE; send bytes as soon as they arrive.
		flush_interval -1
	}
	log {
		output stdout
		format console
		# Caddy redacts Authorization and Cookie headers in access logs by default.
	}
}

# Root domain and www redirect to the app. Each site gets its own
# certificate; if DNS is not pointed here yet, Caddy keeps retrying these two
# with backoff in the background and the site above is unaffected.
{$OPENMAIL_ROOT_DOMAIN:openmail.tools}, www.{$OPENMAIL_ROOT_DOMAIN:openmail.tools} {
	redir https://{$OPENMAIL_DOMAIN:mcp.openmail.tools}{uri} permanent
}
