# Copy to .env on the server, chmod 600. Never commit .env.
# Generate values with: openssl rand -base64 32   (master key)
#                       openssl rand -hex 24      (demo mailbox password)
OPENMAIL_MODE=multi
OPENMAIL_MASTER_KEY=replace-with-base64-32-bytes
OPENMAIL_PUBLIC_URL=https://mcp.openmail.tools
OPENMAIL_DOMAIN=mcp.openmail.tools
OPENMAIL_ROOT_DOMAIN=openmail.tools
OPENMAIL_DEMO_PASSWORD=replace-with-a-random-hex-string
