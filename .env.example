# Copy to .env on the server, chmod 600. Never commit .env.
# Generate values with: openssl rand -base64 32   (master key)
#                       openssl rand -hex 24      (demo mailbox password)
OPENMAIL_MODE=multi
OPENMAIL_MASTER_KEY=replace-with-base64-32-bytes
OPENMAIL_PUBLIC_URL=https://mcp.openmail.tools
OPENMAIL_DOMAIN=mcp.openmail.tools
OPENMAIL_ROOT_DOMAIN=openmail.tools
OPENMAIL_DEMO_PASSWORD=replace-with-a-random-hex-string

# Optional dedicated password-reset email sender (never a user's mailbox).
# OPENMAIL_SYSTEM_SMTP_HOST=
# OPENMAIL_SYSTEM_SMTP_PORT=
# OPENMAIL_SYSTEM_SMTP_SECURE=
# OPENMAIL_SYSTEM_SMTP_USER=
# OPENMAIL_SYSTEM_SMTP_PASS=
# OPENMAIL_SYSTEM_SMTP_FROM=
# Port defaults to 465; SECURE defaults to 1 (implicit TLS). 0 requires STARTTLS.
# OPENMAIL_PUBLIC_URL must be set to the public origin for reset email.
# Optional runtime budgets: defaults 90 calls/minute and 25000 ms IMAP work.
# OPENMAIL_RATE_LIMIT_PER_MINUTE=
# OPENMAIL_IMAP_OP_TIMEOUT_MS=
